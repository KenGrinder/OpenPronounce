# Published GPU image. Set to openpronounce:gpu when building locally on Unraid.
OPENPRONOUNCE_IMAGE=ghcr.io/kengrinder/openpronounce:gpu
OPENPRONOUNCE_PORT=8000
OPENPRONOUNCE_CONFIG_DIR=./data

# Strongly recommended if the API is reachable outside a trusted LAN.
OPENPRONOUNCE_API_KEY=

# Comma-separated browser origins, for example https://pronounce.example.com.
# Use * only on a trusted network.
OPENPRONOUNCE_CORS_ORIGINS=

# The 1080 Ti has enough VRAM for one analysis at a time.
OPENPRONOUNCE_MAX_CONCURRENCY=1
OPENPRONOUNCE_MAX_UPLOAD_MB=25
OPENPRONOUNCE_PRELOAD_MODELS=1

# Piper is local after its first voice download.
OPENPRONOUNCE_TTS=piper
OPENPRONOUNCE_TTS_VOICE=en_US-lessac-medium
NVIDIA_VISIBLE_DEVICES=all

# Keep 127.0.0.1 unless a trusted reverse proxy sends Forwarded/X-Forwarded headers.
FORWARDED_ALLOW_IPS=127.0.0.1

# Browsers block the microphone outside a secure context, so the web UI's record
# button needs https unless you reach it on localhost. Set to "selfsigned" to have
# the container mint its own certificate into /config/certs on first start, or
# "on" to use a certificate you put there yourself. Behind a TLS reverse proxy
# leave this off.
OPENPRONOUNCE_SSL=off
# Every address a browser will use, comma separated. localhost and 127.0.0.1 are
# always included. A certificate that does not name the IP you type is rejected.
OPENPRONOUNCE_SSL_HOSTS=
